*.elf filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# Fuzzing seeds and crash artifacts are small and must NOT go through Git LFS.
fuzz/seeds/**     -filter -diff -merge -text
fuzz/artifacts/** -filter -diff -merge -text
fuzz/corpus/**    -filter -diff -merge -text
